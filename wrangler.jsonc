{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abuto-systems-website",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
