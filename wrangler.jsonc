{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abuto-systems-website",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "abuto-systems-leads",
      "database_id": "52e32b35-ec46-4cd8-b701-f289f560c22f",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "LEAD_NOTIFICATION_EMAIL",
      "destination_address": "abutosystems@gmail.com",
      "allowed_sender_addresses": ["notifications@abutosystems.com"]
    }
  ]
}
