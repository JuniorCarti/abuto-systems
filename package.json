{
  "name": "abuto-systems",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "wrangler dev --ip 127.0.0.1",
    "cf:preview": "npm run build && wrangler dev --ip 127.0.0.1",
    "lint": "eslint app components data lib tests e2e proxy.ts next.config.ts eslint.config.mjs playwright.config.mjs vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run build && node --test tests/site.test.mjs",
    "test:e2e": "playwright test",
    "deploy": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "1.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "axe-core": "^4.13.0",
    "cloudflare": "7.2.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.7",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "1.0.0",
    "vite": "8.3.1",
    "wrangler": "4.144.0"
  },
  "type": "module"
}
